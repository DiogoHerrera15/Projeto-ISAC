NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://isac:isac_local_dev@127.0.0.1:5432/isac_market
MIGRATION_DATABASE_URL=postgres://isac:isac_local_dev@127.0.0.1:5432/isac_market
TEST_DATABASE_URL=postgres://isac:isac_local_dev@127.0.0.1:5432/isac_market_test
# Endereço exato do site no navegador (o backend recusa escritas de outra origem).
# Aceita mais de um, separados por vírgula, sem barra no final. Exemplo no Codespaces:
# APP_ORIGIN=http://localhost:5173,https://NOME-5173.app.github.dev
APP_ORIGIN=http://localhost:5173
# Proxies na frente da API em hospedagem (Render, Railway...): use 1. Local: deixe 0.
TRUST_PROXY=0
UPLOAD_DIR=./uploads
FRONTEND_DIST=
SESSION_TTL_SECONDS=604800
