# Copie este arquivo para .env.local para mudar o comportamento do site.
# Sem ele, o site conversa com o backend em /api/v1 (veja backend/README ou o
# README principal para subir o backend em http://localhost:3001).

# Fonte dos dados: backend (padrão), supabase ou demo.
#   backend  - API Node do projeto (backend/). Em desenvolvimento, o Vite
#              encaminha /api para http://localhost:3001.
#   supabase - banco Supabase (preencha as duas chaves abaixo).
#   demo     - dados de exemplo salvos só no navegador, sem servidor.
# VITE_MODO=backend

# Só no modo backend, se a API não estiver em http://localhost:3001:
# API_PROXY_TARGET=http://localhost:3001

# Só no modo supabase. Use SOMENTE a chave pública "anon"/"publishable"
# (Project Settings > API). Nunca coloque a chave service_role aqui.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon
