# Copie este arquivo para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Use SOMENTE a chave pública "anon"/"publishable".
# Nunca coloque a chave service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon

# Com as variáveis acima vazias, o site roda em MODO DEMONSTRAÇÃO
# (dados de exemplo salvos só no navegador).
